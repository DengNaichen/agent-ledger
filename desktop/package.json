{
  "name": "inftask-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "macOS client for the InfTask cloud instance",
  "author": "InfTask contributors",
  "license": "Apache-2.0",
  "main": "main.cjs",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:packaged": "node scripts/packaged-smoke.mjs",
    "icon": "node scripts/icon.mjs",
    "pack:mac": "electron-builder --mac --arm64 --dir",
    "dist:mac": "electron-builder --mac --arm64"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "4.1.3"
    }
  },
  "build": {
    "appId": "io.github.dengnaichen.inftask.desktop",
    "productName": "InfTask",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "runtime.cjs",
      "policy.cjs",
      "error.html",
      "error.css",
      "assets/icon.icns",
      "package.json"
    ],
    "artifactName": "InfTask-${version}-${arch}.${ext}",
    "mac": {
      "identity": "-",
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
